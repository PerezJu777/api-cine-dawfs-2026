FROM node:22.23.1-slim

WORKDIR /app

RUN npm i -g @nestjs/cli

COPY --chown=1000:1000 package*.json ./

RUN npm ci

COPY --chown=1000:1000 . .

# Compilar el proyecto TypeScript a JavaScript en la carpeta /dist
# RUN npm run build

EXPOSE 3000

USER node

# Ejecutar el proyecto ya compilado desde la carpeta dist
# CMD ["node", "dist/main"]
CMD ["npm", "run", "start:dev"]