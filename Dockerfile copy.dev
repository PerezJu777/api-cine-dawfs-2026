FROM node:22.23.1-slim

WORKDIR /app

RUN npm i -g @nestjs/cli

# COPY package.json ./
# COPY package-lock.json ./
COPY --chown=1000:1000 package*.json .
# COPY package*.json ./

# usar npm install cuando no exista el archivo package-lock.json
# RUN npm install

# Si existe el archivo package-lock.json, usar npm ci
RUN npm ci

RUN chown -R 1000:1000 ./node_modules
COPY --chown=1000:1000 . .

# COPY . .

EXPOSE 3000

# Usar el usuario por defecto de la imagen node (UID 1000) para evitar conflictos de permisos con los volúmenes de Windows
USER node

CMD ["npm", "run", "start:dev"]